* text=auto
*.cs text eol=crlf
*.ps1 text eol=crlf
*.xaml text eol=crlf
*.md text eol=lf
*.txt text eol=lf
*.exe binary
*.dll binary
*.zip binary
# Preserve vendor notice formatting without whitespace diagnostics.
LICENSE-SDL.txt -whitespace
README-SDL.txt -whitespace
# Linux / Raspberry Pi files must keep LF endings even when cloned on Windows.
linux/** text eol=lf
